<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed so "Import from link" can fetch a playlist backup from a
     computer on the same Wi-Fi (e.g. http://192.168.1.10:8000/playlists.txt). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
