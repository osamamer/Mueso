<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.akshay.musicplayer.permission.READ_LIGHT_PROFILES" />

    <!-- The full Nuclear app, whose provider serves this profile's playlists. -->
    <queries>
        <package android:name="com.akshay.musicplayer" />
    </queries>

    <application>
        <!-- A light profile has no Spotify import, so it must not claim the sign-in redirect. -->
        <activity
            android:name=".MainActivity"
            tools:node="merge">
            <intent-filter tools:node="removeAll" />
        </activity>
    </application>
</manifest>
