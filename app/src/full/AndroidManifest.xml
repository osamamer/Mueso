<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only Mueso builds signed with the same key (the light profile apps) may read light profiles. -->
    <permission
        android:name="com.akshay.musicplayer.permission.READ_LIGHT_PROFILES"
        android:protectionLevel="signature" />

    <application>
        <provider
            android:name=".data.profiles.LightProfileProvider"
            android:authorities="com.akshay.musicplayer.lightprofiles"
            android:exported="true"
            android:readPermission="com.akshay.musicplayer.permission.READ_LIGHT_PROFILES" />
    </application>
</manifest>
